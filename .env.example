# ==============================================================================
# INTRIHUB SECURE DEPLOYMENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# SECURITY NOTICE FOR PRODUCTION DEPLOYMENT:
# 1. Never commit .env, .env.local, or .env.production files to version control.
# 2. Store production secrets in a dedicated Secrets Manager:
#    - Vercel Encrypted Environment Variables
#    - AWS Secrets Manager / Parameter Store
#    - Doppler / HashiCorp Vault
# 3. Always enforce SSL for database connections (?sslmode=require).
# 4. Generate high-entropy 256-bit cryptographic keys using:
#    $ openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.intrihub.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SSL & Connection Pooler Enforced)
# ------------------------------------------------------------------------------
# In production, ensure connections use SSL/TLS (?sslmode=require).
# For serverless / high concurrency, use a pooled connection (e.g. Supabase port 6543 / PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Direct URL used strictly for Prisma migrations & introspection
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS (Do not use defaults in production!)
# ------------------------------------------------------------------------------
# HMAC-SHA256 session token secrets (must be unique, random 64+ hex characters)
ADMIN_SESSION_SECRET="generate-with-openssl-rand-hex-32"
VENDOR_SESSION_SECRET="generate-with-openssl-rand-hex-32"
JWT_SECRET="generate-with-openssl-rand-hex-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"

# Strict authorized super-administrator email
ADMIN_ALLOWED_EMAIL="admin@intrihub.com"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="Intrihub <noreply@intrihub.com>"

# Optional SMTP fallback
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@intrihub.com"
SMTP_PASS="your-smtp-secret-password"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="your-live-razorpay-key-secret"

# ------------------------------------------------------------------------------
# 6. STORAGE & MEDIA (Vercel Blob)
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 7. CRON & BACKGROUND JOB SECURITY
# ------------------------------------------------------------------------------
CRON_SECRET="generate-with-openssl-rand-hex-32"
