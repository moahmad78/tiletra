{
  "expo": {
    "name": "Intrihub Business",
    "slug": "intrihub-business",
    "owner": "sahil_sheikh78",
    "version": "1.0.24",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "intrihub-biz",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intrihub.business",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Intrihub Business requires camera access to scan barcode manifests and capture vendor verification documents.",
        "NSPhotoLibraryUsageDescription": "Intrihub Business requires access to your photos to upload catalog products, store banners, and invoice proofs.",
        "NSLocationWhenInUseUsageDescription": "Intrihub Business uses your location to verify warehouse dispatch points and calculate pickup routes.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.intrihub.business",
      "versionCode": 32,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "intrihub-biz"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#052A51"
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withCallKitVoIP"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "107f8b28-48ac-4c6a-b065-8d24f2427724"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/107f8b28-48ac-4c6a-b065-8d24f2427724"
    }
  }
}
