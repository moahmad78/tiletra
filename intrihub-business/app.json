{
  "expo": {
    "name": "Intrihub Business",
    "slug": "intrihub-business",
    "owner": "sahil_sheikh78",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "intrihub-biz",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#052A51"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intrihub.business"
    },
    "android": {
      "package": "com.intrihub.business",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#052A51"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#052A51"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload product and store images."
        }
      ]
    ]
  }
}
