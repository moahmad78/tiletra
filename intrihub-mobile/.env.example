# ==============================================================================
# INTRIHUB MOBILE ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env or .env.local and populate with your actual values.
# ==============================================================================

# Backend API Base URL
EXPO_PUBLIC_API_URL=https://www.intrihub.com

# Google OAuth Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway Key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_or_live_key_id

# Google Maps API Key (Places Autocomplete, Geocoding, Map View)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
