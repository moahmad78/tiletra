{
  "expo": {
    "name": "Intrihub",
    "slug": "intrihub",
    "owner": "sahil_sheikh78",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "intrihub",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intrihub.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Intrihub requires access to your camera to take and upload photos for profile verification and support requests.",
        "NSPhotoLibraryUsageDescription": "Intrihub requires access to your photo library to select and upload images for products, profiles, and order assistance.",
        "NSLocationWhenInUseUsageDescription": "Intrihub requires your location while using the app to accurately calculate delivery times and dispatch materials to your construction site or address.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.intrihub.app",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#052a51"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7c786f97-0217-4a68-b51f-14499a3311a2"
      }
    }
  }
}
