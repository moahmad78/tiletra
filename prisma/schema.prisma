generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. Users & Authentication
// ----------------------------------------------------
model User {
  id                    String                  @id @default(cuid())
  name                  String?
  email                 String?                 @unique
  phone                 String                  @unique
  phoneVerified         Boolean                 @default(false)
  emailVerified         Boolean                 @default(false)
  role                  String                  @default("customer") // customer | vendor | admin | staff
  authProvider          String?                 // "google" | "email" | "phone" | "credentials"
  passwordHash          String?
  mustChangePassword    Boolean                 @default(false)
  avatar                String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  cart                  Cart?
  notifications         Notification[]
  notificationPreference NotificationPreference?
  recentlyViewed        RecentlyViewed[]
  wishlist              WishlistItem[]
  pushTokens            MobilePushToken[]
  returnRequests        ReturnRequest[]
  auditLogs             AuditLog[]
  staffPermissions      StaffPermission[]
  vendor                Vendor?                 @relation("VendorOwner")

  @@index([phone])
  @@index([email])
  @@index([role])
}

// Email OTP token store (5-minute expiry)
model EmailOtpToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([used])
}

model Address {
  id                   String   @id @default(cuid())
  userId               String
  label                String   @default("Home") // Home | Work | Site | Other
  fullName             String?
  phone                String?
  houseNumber          String?  // House/Flat/Shop Number
  buildingName         String?  // Building / Apartment Name
  floor                String?  // Floor / Unit
  street               String   // Street / Road / Cross
  area                 String?  // Area / Locality / Sector
  landmark             String?  // Nearby Landmark
  city                 String   @default("Bangalore")
  district             String?
  state                String   @default("Karnataka")
  country              String   @default("India")
  pincode              String
  postalCode           String?
  latitude             Float?
  longitude            Float?
  accuracy             Float?   // GPS accuracy in meters
  source               String   @default("GPS") // GPS | MAP_PIN | SEARCH | MANUAL
  deliveryInstructions String?  // Gate code, call instructions, etc.
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([latitude, longitude])
}

// ----------------------------------------------------
// 2. Catalog: Categories, Products & Variants
// ----------------------------------------------------
model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  icon            String     @default("Grid")
  description     String     @default("")
  image           String     @default("")
  popularFinishes String[]   @default([])
  popularSizes    String[]   @default([])
  calculatorType  String     @default("none") // none | area_to_boxes | area_to_volume | length_to_units
  calculatorInputType String @default("area") // area | length | none
  order           Int        @default(0)
  parentId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryHierarchy")
  products        Product[]

  @@index([parentId])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  categoryId        String?
  categorySlug      String             @default("floor-tiles")
  categoryName      String             @default("Floor Tiles")
  subcategory       String?
  brand             String?            @default("Intrihub")
  modelNumber       String?
  sku               String?

  // Canonical Selling Unit & Packaging Conversion
  unitOfSale        String             @default("box") // Canonical selling unit: box | sqft | piece | meter | coil | kg | pack | roll | litre | can | sheet | slab | bucket | drum | bottle | tube | dozen | ton
  baseUnit          String?            // Reference unit e.g. "sqft", "meter", "piece", "litre", "kg"
  conversionRatio   Float?             // e.g. 4.5 sqft per box, 90m per roll, 20L per bucket
  coverageRate      Float?             // Coverage in sq.ft per selling unit
  piecesPerBox      Int?               // Pieces per box (for box-based items like tiles)
  piecesPerUnit     Int?               // Pieces per pack/box
  lengthPerUnit     Float?             // Length per roll/bundle in meters
  weightKg          Float?             // Weight per selling unit in kg
  isBulky           Boolean            @default(false) // Oversized items e.g. plywood, pipes, false-ceiling panels

  // Quantities & Ordering Rules
  minOrderQuantity  Float              @default(1)
  maxOrderQuantity  Float?
  incrementQuantity Float              @default(1)
  allowDecimals     Boolean            @default(false)
  decimalPrecision  Int                @default(0)

  // Standard Product Attributes
  material          String             @default("Vitrified")
  finish            String             @default("Glossy")
  size              String             @default("600x600mm")
  thickness         String             @default("9mm")
  usage             String             @default("Indoor / Floor")
  look              String             @default("Marble Look")
  grade             String?            // e.g. "Commercial", "MR", "BWP", "Grade A"
  series            String?            // e.g. "Royal Collection"
  warranty          String?            // e.g. "10 Years Warranty"
  countryOfOrigin   String             @default("India")
  hsnCode           String?            // GST HSN/SAC code
  gstPercent        Float              @default(18)

  // Pricing
  pricePerSqft      Float              @default(45) // Equivalent reference price
  mrp               Float?             // List price / MRP in INR
  wastageFactor     Float?             @default(1.1)

  // Flags & Media
  isTrending        Boolean            @default(false)
  isBestseller      Boolean            @default(false)
  isNewArrival      Boolean            @default(false)
  inStock           Boolean            @default(true)
  images            String[]           @default([])
  videos            String[]           @default([])
  description       String             @default("")
  shortDescription  String?
  rating            Float              @default(4.8)
  avgRating         Float?             @default(0)
  reviewCount       Int                @default(0)
  manualRating      Float?
  manualReviewCount Int?
  specs             Json?

  // Multi-Vendor fields
  vendorId          String?
  status            String             @default("active") // active | paused | draft | archived
  approvalStatus    String             @default("approved") // pending | approved | rejected
  rejectionReason   String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor            Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  attributes        ProductAttribute[]
  priceTiers        PriceTier[]
  reviews           Review[]
  orderItems        OrderItem[]
  recentlyViewed    RecentlyViewed[]
  wishlistItems     WishlistItem[]

  @@index([categorySlug])
  @@index([vendorId])
  @@index([status])
  @@index([approvalStatus])
  @@index([status, approvalStatus, createdAt])
  @@index([status, approvalStatus, isTrending])
  @@index([status, approvalStatus, isBestseller])
  @@index([status, approvalStatus, isNewArrival])
  @@index([status, approvalStatus, categorySlug])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  key       String   // e.g. "gauge", "thickness", "material", "packOf", "pattern", "headType", "driveType"
  value     String   // e.g. "2.5 sq mm", "18mm", "SS 304", "100 Pcs", "Geometric", "Phillips"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  sku            String?
  size           String
  finish         String
  color          String      // Canonical colour name e.g. "Grey", "Alaska White"
  colorHex       String?     // Hex code e.g. "#808080"
  swatchImage    String?     // Texture image URL for stone, wood, granite
  image          String?     // Variant specific product image
  unit           String?     // Variant selling unit override
  attributeLabel String?
  attributeValue String?
  variantSpecs   Json?       // Category-specific variant attributes
  weightKg       Float?      @default(2.5) // in kilograms
  mrp            Float?      // MRP in INR for variant
  pricePerSqft   Float       // Equivalent Reference Price
  pricePerBox    Float       // Variant Selling Unit Price
  sqftPerBox     Float       // Conversion ratio / coverage
  piecesPerBox   Int         @default(4)
  inStock        Boolean     @default(true)
  stockBoxes     Int         @default(50)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  priceTiers     PriceTier[]

  @@index([productId])
  @@index([color])
  @@index([size])
}

model Colour {
  id           String   @id @default(cuid())
  name         String   @unique
  hexCode      String
  secondaryHex String?
  swatchImage  String?
  categorySlug String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

model PriceTier {
  id           String          @id @default(cuid())
  productId    String
  variantId    String?
  minQuantity  Float           // Minimum quantity for tier (e.g. 10)
  maxQuantity  Float?          // Maximum quantity for tier (e.g. 49)
  price        Float           // Tier unit price (e.g. 1300)
  customerType String          @default("all") // all | b2b | contractor | retail
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

// ----------------------------------------------------
// 3. Cart & Synced Cart Items
// ----------------------------------------------------
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String         @id @default(cuid())
  cartId      String
  productId   String
  variantId   String
  boxQuantity Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ----------------------------------------------------
// 4. Orders, Order Items & Return Requests
// ----------------------------------------------------
model Order {
  id                     String          @id
  userId                 String?
  customerName           String
  customerPhone          String
  customerEmail          String          @default("customer@intrihub.com")
  shippingAddress        Json
  subtotal               Float
  deliveryFee            Float           @default(0)
  discount               Float           @default(0)
  total                  Float
  paymentStatus          String          @default("Pending") // Paid | Pending | Refunded
  paymentMethod          String          @default("Online")  // Online | COD | UPI | Card | NetBanking
  codConfirmed           Boolean         @default(false)
  paymentCollected       Boolean         @default(false)
  paymentId              String?
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySignature      String?
  orderStatus            String          @default("Processing") // Processing | Confirmed | Dispatched | Out for Delivery | Delivered | Cancelled
  courierName            String?
  trackingNumber         String?
  internalNotes          String?
  estimatedDelivery      String          @default("Within 60 Minutes")

  // Immutable Delivery Snapshot
  deliveryName           String?
  deliveryPhone          String?
  deliveryAddress        String?
  deliveryHouseNumber    String?
  deliveryBuildingName   String?
  deliveryFloor          String?
  deliveryStreet         String?
  deliveryArea           String?
  deliveryLandmark       String?
  deliveryCity           String?
  deliveryDistrict       String?
  deliveryState          String?
  deliveryCountry        String?         @default("India")
  deliveryPostalCode     String?
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  deliveryAccuracy       Float?
  deliveryLocationSource String?         @default("GPS") // GPS | MAP_PIN | SEARCH | MANUAL
  deliveryInstructions   String?

  // Delivery Partner Assignment & Live Tracking
  deliveryPartnerId      String?
  deliveryAssignedAt     DateTime?
  deliveryArrivedAt      DateTime?
  deliveredAt            DateTime?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryPartner        DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  returnRequests         ReturnRequest[]
  reviews                Review[]
  locationLogs           DeliveryLocationLog[]

  @@index([customerPhone])
  @@index([orderStatus])
  @@index([userId])
  @@index([deliveryPartnerId])
  @@index([deliveryLatitude, deliveryLongitude])
}

model DeliveryPartner {
  id               String               @id @default(cuid())
  userId           String?              @unique
  name             String
  phone            String               @unique
  email            String?
  vehicleType      String               @default("bike") // bike | scooter | van | truck
  vehicleNumber    String?
  currentLatitude  Float?
  currentLongitude Float?
  currentAccuracy  Float?
  lastLocationAt   DateTime?
  status           String               @default("available") // available | on_delivery | offline
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  orders           Order[]
  locationLogs     DeliveryLocationLog[]

  @@index([phone])
  @@index([status])
}

model DeliveryLocationLog {
  id                String          @id @default(cuid())
  orderId           String?
  deliveryPartnerId String
  latitude          Float
  longitude         Float
  accuracy          Float?
  speed             Float?
  heading           Float?
  timestamp         DateTime        @default(now())

  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([timestamp])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String?
  productName    String
  variantId      String
  variantDetails String
  boxQuantity    Int
  pricePerBox    Float
  totalPrice     Float
  image          String          @default("")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

model ReturnRequest {
  id          String     @id @default(cuid())
  orderId     String
  orderItemId String?
  userId      String?
  reason      String
  status      String     @default("Pending") // Pending | Approved | Rejected | Completed
  photos      String[]   @default([])
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
}

// ----------------------------------------------------
// 5. Customers (CRM)
// ----------------------------------------------------
model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  city        String   @default("Bangalore")
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  status      String   @default("Active") // Active | Blocked
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
}

// ----------------------------------------------------
// 6. Reviews
// ----------------------------------------------------
model Review {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String       // the order that proves verified purchase
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating        Int          // 1-5
  title         String?
  body          String?
  status        ReviewStatus @default(PUBLISHED) // PUBLISHED | HIDDEN
  hiddenReason  String?      // set by admin when hiding
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  media         ReviewMedia[]

  @@unique([userId, productId, orderId]) // one review per purchase-line, not per product overall
  @@index([productId, status])
  @@index([userId])
  @@index([orderId])
}

model ReviewMedia {
  id           String    @id @default(cuid())
  reviewId     String
  review       Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type         MediaType // IMAGE | VIDEO
  url          String    // Vercel Blob URL
  thumbnailUrl String?   // for video, generated thumbnail
  createdAt    DateTime  @default(now())

  @@index([reviewId])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum MediaType {
  IMAGE
  VIDEO
}

// ----------------------------------------------------
// 7. Coupons & Discounts
// ----------------------------------------------------
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountType   String   @default("percentage") // percentage | flat
  value          Float
  minOrderValue  Float    @default(0)
  maxDiscountCap Float?
  usageLimit     Int?
  usedCount      Int      @default(0)
  validFrom      String   @default("2026-01-01")
  validTill      String   @default("2026-12-31")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ----------------------------------------------------
// 8. Offer Banners & Content
// ----------------------------------------------------
model OfferBanner {
  id         String   @id @default(cuid())
  badge      String   @default("Special Offer")
  title      String
  subtitle   String   @default("")
  cta        String   @default("Shop Now")
  href       String   @default("/shop")
  image      String   @default("")
  bgGradient String   @default("from-[#052a51]/95 via-[#052a51]/80 to-transparent")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Alias for PRD Banner compatibility
model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  badge      String?
  image      String
  link       String   @default("/shop")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ----------------------------------------------------
// 9. Store Settings & Shipping Zones
// ----------------------------------------------------
model StoreSettings {
  id                    String   @id @default("default-settings")
  storeName             String   @default("Intrihub")
  contactPhone          String   @default("+91 70901 20211")
  whatsappNumber        String   @default("+91 70901 20211")
  email                 String   @default("support@intrihub.com")
  address               String   @default("Intrihub Central Supply Hub, Begur, Bengaluru, Karnataka 560114")
  gstNumber             String?  @default("29AABCT1234F1Z8")
  freeDeliveryThreshold Float    @default(15000)
  standardDeliveryFee   Float    @default(999)
  deliveryFeeEnabled    Boolean  @default(true)
  bikeDeliveryRate      Float    @default(99)
  fourWheelerDeliveryRate Float  @default(349)
  weightThresholdKg     Float    @default(20)
  autoAcceptOrders      Boolean  @default(true)
  lowStockThreshold     Int      @default(10)
  codEnabled            Boolean  @default(true)
  codMaxLimit           Float    @default(25000)
  codBlockedPincodes    String[] @default(["560099"])
  estimatedDelivery     String   @default("Within 60 Minutes")
  updatedAt             DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id                      String   @id @default(cuid())
  name                    String
  pincodes                String[] @default([])
  fee                     Float    @default(999)
  minOrderForFreeShipping Float    @default(15000)
  estimatedDelivery       String   @default("Within 60 Minutes")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ----------------------------------------------------
// 10. Notifications & Preferences
// ----------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // order | promo | system | info
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  orderUpdates Boolean  @default(true)
  promotional  Boolean  @default(true)
  email        Boolean  @default(true)
  sms          Boolean  @default(true)
  whatsapp     Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("general") // new_order | low_stock | return_request | review | general
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?    // arbitrary extra data (orderId, productId, etc.)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ----------------------------------------------------
// 11. Customer Activity & Recently Viewed
// ----------------------------------------------------
model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  viewedAt  DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([sessionId])
}

// ----------------------------------------------------
// 12. Staff, RBAC & Audit Logs
// ----------------------------------------------------
model StaffPermission {
  id          String   @id @default(cuid())
  userId      String
  permissions String[] @default([])
  role        String   @default("staff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([userId])
}

// ----------------------------------------------------
// 13. Multi-Vendor Marketplace
// ----------------------------------------------------
model Vendor {
  id              String             @id @default(cuid())
  businessName    String
  slug            String             @unique
  logo            String?
  description     String?            @default("")
  contactEmail    String
  contactPhone    String
  businessAddress String?
  category        String?            @default("General")
  gstNumber       String?
  status          String             @default("pending") // pending | approved | rejected | suspended
  rejectionReason String?
  commissionRate  Float              @default(15.0) // % platform fee
  ownerId         String             @unique
  applicationId   String?
  onboardingPath  String             @default("admin_created") // self_apply | admin_created

  // Bank & Payout Details
  bankAccountHolder String?
  bankName          String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankUpiId         String?

  // Shop Storefront & KYC Legal Documents
  shopPhotoUrl        String?
  panNumber           String?
  panDocUrl           String?
  aadharNumber        String?
  aadharDocUrl        String?
  gstDocUrl           String?
  chequeDocUrl        String?
  tradeLicenseDocUrl  String?
  kycStatus           String             @default("pending") // pending | submitted | verified | rejected
  kycNotes            String?

  // Delivery & Shipping Controls
  deliveryMethod        String             @default("self") // self | platform (vendor choice)
  deliveryFeeEnabled    Boolean            @default(true)
  customDeliveryFee     Float?             // null means follow store standard fee
  freeDeliveryThreshold Float?             // null means follow store threshold

  // Auto-Publishing Controls (Super Admin permission)
  autoPublishEnabled    Boolean            @default(false)

  // Pickup / Dispatch Location
  latitude              Float?
  longitude             Float?
  locationAccuracy      Float?

  // Quick Commerce Automation (F3 / F5)
  autoAcceptOrders      Boolean            @default(false) // per-vendor: skip manual accept step
  serviceAreaRadiusKm   Float              @default(10)    // max km from vendor to accept geo-routed orders

  // Authentication Method (Admin-Configurable: otp vs password)
  loginMethod         String             @default("otp") // otp | password
  passwordHash        String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner           User               @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  products        Product[]
  splits          VendorOrderSplit[]
  payouts         Payout[]
  coupons         VendorCoupon[]

  @@index([status])
  @@index([ownerId])
  @@index([applicationId])
}

model VendorApplication {
  id              String   @id @default(cuid())
  businessName    String
  ownerName       String
  phone           String
  email           String
  category        String   @default("General")
  address         String?
  description     String?  @default("")
  aadharDocUrl    String?
  panDocUrl       String?
  shopPhotoUrl    String?
  status          String   @default("new_inquiry") // new_inquiry | contacted | converted | rejected
  internalNotes   String?
  rejectionReason String?
  vendorId        String?  // linked Vendor ID once converted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([email])
}

model VendorOrderSplit {
  id                   String    @id @default(cuid())
  orderId              String
  vendorId             String
  subtotal             Float
  commissionRate       Float     @default(15.0)
  commissionAmount     Float     @default(0)
  vendorPayoutAmount   Float     @default(0)
  deliveryMethod       String    @default("self") // self | platform (captured at order creation)
  fulfillmentStatus    String    @default("processing") // processing | confirmed | ready_for_pickup | picked_up | dispatched | out_for_delivery | delivered | cancelled | returned
  paymentCollected     Boolean   @default(false)  // true once cash/online payment is collected
  trackingNumber       String?
  courierName          String?
  deliveredAt          DateTime?
  payoutId             String?

  // ── SLA Packing Timer (F4) ──────────────────────────────────────────────────
  acceptedAt           DateTime? // set when status → "confirmed" (auto or manual)
  packingDeadline      DateTime? // acceptedAt + PACKING_SLA_MINUTES (default 10 min)
  packingBreachAt      DateTime? // set by SLA cron when deadline missed without ready_for_pickup
  slaBreach            Boolean   @default(false)

  // ── Third-Party Delivery Fallback & Carrier Routing (F6 / F8) ─────────────
  thirdPartyRef        String?   // Porter/Borzo booking reference ID
  thirdPartyProvider   String?   // "in_house" | "borzo" | "porter" | "dunzo" | "shiprocket"
  vehicleType          String?   // "bike" | "3-wheeler" | "tata-ace" | "truck"
  totalWeightKg        Float?    // Total sum weight of items in split (kg)
  isBulky              Boolean   @default(false) // True if any item in split is bulky

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vendor               Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payout               Payout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([vendorId])
  @@index([fulfillmentStatus])
  @@index([deliveryMethod])
  @@index([payoutId])
  @@index([slaBreach])
  @@index([packingDeadline])
}

model Payout {
  id             String             @id @default(cuid())
  vendorId       String
  amount         Float
  status         String             @default("pending") // pending | processing | completed | held
  periodStart    DateTime
  periodEnd      DateTime
  initiatedAt    DateTime           @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  vendor         Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  splits         VendorOrderSplit[]

  @@index([vendorId])
  @@index([status])
}

model VendorCoupon {
  id           String    @id @default(cuid())
  vendorId     String
  code         String
  discountType String    @default("percentage") // percentage | flat
  value        Float
  minOrderValue Float    @default(0)
  validFrom    DateTime  @default(now())
  validTill    DateTime
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, code])
  @@index([vendorId])
}

// ----------------------------------------------------
// Persistent Database Media & Image Storage
// ----------------------------------------------------
model UploadedFile {
  id          String   @id @default(cuid())
  fileName    String   @unique
  mimeType    String   @default("image/jpeg")
  dataBase64  String   @db.Text
  sizeBytes   Int      @default(0)
  altText     String?
  createdAt   DateTime @default(now())

  @@index([fileName])
}

// ----------------------------------------------------
// 14. Mobile Device Push Tokens & Wishlist
// ----------------------------------------------------
model MobilePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("android") // android | ios
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ----------------------------------------------------
// 15. SEO Automated Redirects
// ----------------------------------------------------
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromPath])
}

// ----------------------------------------------------
// 16. SEO Landing Pages & Keyword System
// ----------------------------------------------------
model SeoPage {
  id              String      @id @default(cuid())
  slug            String      @unique          // e.g. "tiles", "tiles/vitrified-tiles", "tiles-shop-in-bangalore"
  aliases         String[]    @default([])     // alternate slugs that 301-redirect to this page
  pageType        SeoPageType
  category        String?                      // e.g. "tiles", "plywood" — used for internal linking
  locality        String?                      // e.g. "bengaluru", "begur" — null for non-local pages
  targetKeyword   String                       // primary keyword this page is built for
  title           String                       // <title> tag
  metaDescription String
  h1              String
  introContent    String      @db.Text         // 300+ word unique intro, supports markdown
  faqItems        Json?                        // [{question, answer}, ...] for FAQ schema
  productFilter   Json?                        // filter config to pull real products from catalog for this page
  isPublished     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([pageType])
  @@index([category])
  @@index([locality])
}

enum SeoPageType {
  CATEGORY
  SUBCATEGORY
  LOCAL
  PRICE_INTENT
  TREND
}

// ----------------------------------------------------
// 17. IntriHub Connect (Unified Communication & AI Support)
// ----------------------------------------------------
model ConnectCustomer {
  id            String   @id @default(cuid())
  name          String
  phone         String?  @unique
  email         String?  @unique
  company       String?
  city          String?  @default("Bangalore")
  state         String?  @default("Karnataka")
  pincode       String?
  tags          String[] @default([]) // e.g. "VIP", "Contractor", "Interior Designer", "High Value"
  notes         String?  @db.Text
  totalOrders   Int      @default(0)
  totalSpend    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations ConnectConversation[]
  tickets       ConnectTicket[]

  @@index([phone])
  @@index([email])
}

model ConnectConversation {
  id            String   @id @default(cuid())
  customerId    String
  channel       String   // "WHATSAPP" | "EMAIL"
  accountEmail  String?  // e.g. "support@intrihub.com" or "sales@intrihub.com"
  subject       String?
  status        String   @default("OPEN") // "OPEN" | "PENDING" | "WAITING_CUSTOMER" | "RESOLVED"
  priority      String   @default("NORMAL") // "LOW" | "NORMAL" | "HIGH" | "URGENT"
  assignedTo    String?  // Agent Name / ID
  isStarred     Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      ConnectCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages      ConnectMessage[]
  tickets       ConnectTicket[]
  aiRuns        ConnectAiRun[]

  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@index([assignedTo])
  @@index([lastMessageAt])
}

model ConnectMessage {
  id                 String   @id @default(cuid())
  conversationId     String
  channel            String   // "WHATSAPP" | "EMAIL"
  sender             String   // Customer name or Agent name
  recipient          String?
  direction          String   // "INBOUND" | "OUTBOUND"
  body               String   @db.Text
  originalBody       String?  @db.Text
  translatedBody     String?  @db.Text
  detectedLanguage   String?  @default("English")
  sentiment          String?  @default("Neutral")
  messageType        String   @default("TEXT") // "TEXT" | "IMAGE" | "DOCUMENT" | "AUDIO"
  attachments        Json?    // [{ url, name, size, type }]
  status             String   @default("DELIVERED") // "SENDING" | "SENT" | "DELIVERED" | "READ" | "FAILED"
  externalMessageId  String?
  createdAt          DateTime @default(now())

  conversation       ConnectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([direction])
}

model ConnectTicket {
  id                      String    @id @default(cuid())
  ticketNumber            String    @unique // e.g. "TICK-10291"
  conversationId          String?
  customerId              String
  subject                 String
  description             String?   @db.Text
  priority                String    @default("NORMAL") // "LOW" | "NORMAL" | "HIGH" | "URGENT"
  category                String    @default("General") // "Product" | "Delivery" | "Payment" | "Vendor" | "General"
  status                  String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "WAITING_CUSTOMER" | "RESOLVED" | "CLOSED"
  assignedAgent           String?
  slaFirstResponseMinutes Int       @default(15)
  slaResolutionHours      Int       @default(24)
  dueAt                   DateTime?
  resolvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer                ConnectCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation            ConnectConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([assignedAgent])
}

model ConnectKnowledgeSource {
  id          String                  @id @default(cuid())
  title       String
  category    String                  // "POLICIES" | "FAQS" | "PRODUCTS" | "SERVICES" | "SOP"
  sourceUrl   String?
  version     String                  @default("1.0")
  status      String                  @default("APPROVED") // "DRAFT" | "APPROVED" | "ARCHIVED"
  approvedBy  String?                 @default("System Admin")
  approvedAt  DateTime?               @default(now())
  content     String                  @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  chunks      ConnectKnowledgeChunk[]

  @@index([category])
  @@index([status])
}

model ConnectKnowledgeChunk {
  id        String                 @id @default(cuid())
  sourceId  String
  title     String
  content   String                 @db.Text
  tags      String[]               @default([])
  createdAt DateTime               @default(now())

  source    ConnectKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model ConnectAiRun {
  id               String   @id @default(cuid())
  conversationId   String
  messageId        String?
  model            String   @default("gemini-1.5-pro")
  intent           String   // e.g. "Product Availability", "Delivery ETA"
  detectedLanguage String   @default("English")
  confidence       Int      @default(90) // Percentage 0-100
  suggestedReply   String   @db.Text
  sourcesUsed      Json?    // [{ source: "Delivery Policy v3.2", ref: "..." }]
  status           String   @default("ACCEPTED") // "PENDING" | "ACCEPTED" | "EDITED" | "REJECTED"
  agentActionNote  String?
  createdAt        DateTime @default(now())

  conversation     ConnectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
}

model ConnectTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   // "Customer Support" | "Order confirmation" | "Delivery update" | "Sales" | "Vendor"
  channel     String   @default("ALL") // "WHATSAPP" | "EMAIL" | "ALL"
  subject     String?
  htmlContent String?  @db.Text
  textContent String   @db.Text
  variables   String[] @default([]) // e.g. ["customer_name", "order_id"]
  language    String   @default("English")
  status      String   @default("APPROVED") // "DRAFT" | "APPROVED"
  createdBy   String?  @default("Admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([channel])
}

model ConnectSavedReply {
  id        String   @id @default(cuid())
  title     String
  shortcut  String?  // e.g. "/delivery"
  content   String   @db.Text
  variables String[] @default([])
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model ConnectAuditLog {
  id         String   @id @default(cuid())
  agentName  String
  agentEmail String?
  action     String   // "SENT_MESSAGE" | "EDITED_AI_SUGGESTION" | "CREATED_TICKET" | "UPDATED_KNOWLEDGE"
  details    String   @db.Text
  entityType String?  // "Conversation" | "Ticket" | "Knowledge"
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([agentName])
  @@index([action])
  @@index([createdAt])
}

// ----------------------------------------------------
// 12. Blog & Material Buying Guides (Content Management)
// ----------------------------------------------------
model GuidePost {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  featuredImage    String
  featuredImageAlt String?     @default("")
  excerpt          String?     @db.Text
  content          String      @db.Text
  metaTitle        String?
  metaDescription  String?     @db.Text
  category         String      @default("Trends") // "Trends" | "Buying Guide" | "How-To" | "Product Spotlight"
  tags             String[]    @default([])
  keywords         String[]    @default([])
  status           String      @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "SCHEDULED"
  publishedAt      DateTime    @default(now())
  authorName       String      @default("IntriHub Team")
  readTimeMinutes  Int         @default(5)
  viewsCount       Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([category])
}
