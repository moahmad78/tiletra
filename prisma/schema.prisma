generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. Users & Authentication
// ----------------------------------------------------
model User {
  id                    String                  @id @default(cuid())
  name                  String?
  email                 String?                 @unique
  phone                 String                  @unique
  phoneVerified         Boolean                 @default(false)
  emailVerified         Boolean                 @default(false)
  role                  String                  @default("customer") // customer | vendor | admin | staff
  authProvider          String?                 // "google" | "email" | "phone" | "credentials"
  passwordHash          String?
  mustChangePassword    Boolean                 @default(false)
  avatar                String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  cart                  Cart?
  notifications         Notification[]
  notificationPreference NotificationPreference?
  recentlyViewed        RecentlyViewed[]
  returnRequests        ReturnRequest[]
  auditLogs             AuditLog[]
  staffPermissions      StaffPermission[]
  vendor                Vendor?                 @relation("VendorOwner")

  @@index([phone])
  @@index([email])
  @@index([role])
}

// Email OTP token store (expires after 10 minutes)
model EmailOtpToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home") // Home | Work | Site | Other
  street    String
  landmark  String?
  city      String   @default("Bangalore")
  state     String   @default("Karnataka")
  pincode   String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------
// 2. Catalog: Categories, Products & Variants
// ----------------------------------------------------
model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  icon            String     @default("Grid")
  description     String     @default("")
  image           String     @default("")
  popularFinishes String[]   @default([])
  popularSizes    String[]   @default([])
  calculatorType  String     @default("none") // none | area_to_boxes | area_to_volume | length_to_units
  order           Int        @default(0)
  parentId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryHierarchy")
  products        Product[]

  @@index([parentId])
}

model Product {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  categoryId    String?
  categorySlug  String             @default("floor-tiles")
  categoryName  String             @default("Floor Tiles")
  subcategory   String?
  unitOfSale    String             @default("box") // box | sqft | piece | meter | coil | kg | pack | roll | litre | can
  material      String             @default("Vitrified")
  finish        String             @default("Glossy")
  size          String             @default("600x600mm")
  pricePerSqft  Float              @default(45)
  thickness     String             @default("9mm")
  usage         String             @default("Indoor / Floor")
  look          String             @default("Marble Look")
  coverageRate  Float?             // sq.ft per box (tiles), sq.ft per litre (paint), meters per coil (wire)
  wastageFactor Float?             @default(1.1) // 1.1 = 10% wastage buffer
  isTrending    Boolean            @default(false)
  isBestseller  Boolean            @default(false)
  isNewArrival  Boolean            @default(false)
  inStock       Boolean            @default(true)
  images        String[]           @default([])
  description   String             @default("")
  rating        Float              @default(4.8)
  reviewCount   Int                @default(12)
  manualRating  Float?
  manualReviewCount Int?
  specs         Json?

  // Multi-Vendor fields
  vendorId         String?
  status           String             @default("active") // active | paused | draft
  approvalStatus   String             @default("approved") // pending | approved | rejected
  rejectionReason  String?

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor       Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  attributes   ProductAttribute[]
  reviews      Review[]
  orderItems   OrderItem[]
  recentlyViewed RecentlyViewed[]

  @@index([categorySlug])
  @@index([isTrending])
  @@index([isBestseller])
  @@index([vendorId])
  @@index([status])
  @@index([approvalStatus])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  key       String   // e.g. "gauge", "thickness", "material", "packOf", "pattern"
  value     String   // e.g. "2.5 sq mm", "18mm", "SS 304", "100 Pcs", "Geometric"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String     @id @default(cuid())
  productId      String
  size           String
  finish         String
  color          String
  image          String?
  unit           String?
  attributeLabel String?
  attributeValue String?
  pricePerSqft   Float
  pricePerBox    Float
  sqftPerBox     Float
  piecesPerBox   Int        @default(4)
  inStock        Boolean    @default(true)
  stockBoxes     Int        @default(50)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]

  @@index([productId])
}

// ----------------------------------------------------
// 3. Cart & Synced Cart Items
// ----------------------------------------------------
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String         @id @default(cuid())
  cartId      String
  productId   String
  variantId   String
  boxQuantity Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ----------------------------------------------------
// 4. Orders, Order Items & Return Requests
// ----------------------------------------------------
model Order {
  id                String          @id
  userId            String?
  customerName      String
  customerPhone     String
  customerEmail     String          @default("customer@intrihub.com")
  shippingAddress   Json
  subtotal          Float
  deliveryFee       Float           @default(0)
  discount          Float           @default(0)
  total             Float
  paymentStatus     String          @default("Pending") // Paid | Pending | Refunded
  paymentMethod     String          @default("Online")  // Online | COD | UPI | Card | NetBanking
  codConfirmed      Boolean         @default(false)
  paymentCollected  Boolean         @default(false)
  paymentId         String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  orderStatus       String          @default("Processing") // Processing | Confirmed | Dispatched | Out for Delivery | Delivered | Cancelled
  courierName       String?
  trackingNumber    String?
  internalNotes     String?
  estimatedDelivery String          @default("3–5 Business Days")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  returnRequests    ReturnRequest[]

  @@index([customerPhone])
  @@index([orderStatus])
  @@index([userId])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String?
  productName    String
  variantId      String
  variantDetails String
  boxQuantity    Int
  pricePerBox    Float
  totalPrice     Float
  image          String          @default("")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

model ReturnRequest {
  id          String     @id @default(cuid())
  orderId     String
  orderItemId String?
  userId      String?
  reason      String
  status      String     @default("Pending") // Pending | Approved | Rejected | Completed
  photos      String[]   @default([])
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
}

// ----------------------------------------------------
// 5. Customers (CRM)
// ----------------------------------------------------
model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  city        String   @default("Bangalore")
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  status      String   @default("Active") // Active | Blocked
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
}

// ----------------------------------------------------
// 6. Reviews
// ----------------------------------------------------
model Review {
  id               String   @id @default(cuid())
  productId        String
  productName      String
  userId           String?
  author           String
  city             String   @default("Bangalore")
  rating           Int      @default(5)
  comment          String
  date             String
  status           String   @default("approved") // pending | approved | rejected
  photos           String[] @default([])
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@index([userId])
}

// ----------------------------------------------------
// 7. Coupons & Discounts
// ----------------------------------------------------
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountType   String   @default("percentage") // percentage | flat
  value          Float
  minOrderValue  Float    @default(0)
  maxDiscountCap Float?
  usageLimit     Int?
  usedCount      Int      @default(0)
  validFrom      String   @default("2026-01-01")
  validTill      String   @default("2026-12-31")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ----------------------------------------------------
// 8. Offer Banners & Content
// ----------------------------------------------------
model OfferBanner {
  id         String   @id @default(cuid())
  badge      String   @default("Special Offer")
  title      String
  subtitle   String   @default("")
  cta        String   @default("Shop Now")
  href       String   @default("/shop")
  image      String   @default("")
  bgGradient String   @default("from-[#052a51]/95 via-[#052a51]/80 to-transparent")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Alias for PRD Banner compatibility
model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  badge      String?
  image      String
  link       String   @default("/shop")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ----------------------------------------------------
// 9. Store Settings & Shipping Zones
// ----------------------------------------------------
model StoreSettings {
  id                    String   @id @default("default-settings")
  storeName             String   @default("Intrihub")
  contactPhone          String   @default("+91 78709 35277")
  whatsappNumber        String   @default("+91 78709 35277")
  email                 String   @default("info@intrihub.com")
  address               String   @default("Intrihub Central Supply Hub, Begur, Bengaluru, Karnataka 560114")
  freeDeliveryThreshold Float    @default(15000)
  standardDeliveryFee   Float    @default(999)
  deliveryFeeEnabled    Boolean  @default(true)
  autoAcceptOrders      Boolean  @default(true)
  lowStockThreshold     Int      @default(10)
  codEnabled            Boolean  @default(true)
  codMaxLimit           Float    @default(25000)
  codBlockedPincodes    String[] @default(["560099"])
  updatedAt             DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id                      String   @id @default(cuid())
  name                    String
  pincodes                String[] @default([])
  fee                     Float    @default(999)
  minOrderForFreeShipping Float    @default(15000)
  estimatedDelivery       String   @default("3–5 Business Days")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ----------------------------------------------------
// 10. Notifications & Preferences
// ----------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // order | promo | system | info
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  orderUpdates Boolean  @default(true)
  promotional  Boolean  @default(true)
  email        Boolean  @default(true)
  sms          Boolean  @default(true)
  whatsapp     Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("general") // new_order | low_stock | return_request | review | general
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?    // arbitrary extra data (orderId, productId, etc.)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ----------------------------------------------------
// 11. Customer Activity & Recently Viewed
// ----------------------------------------------------
model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  viewedAt  DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([sessionId])
}

// ----------------------------------------------------
// 12. Staff, RBAC & Audit Logs
// ----------------------------------------------------
model StaffPermission {
  id          String   @id @default(cuid())
  userId      String
  permissions String[] @default([])
  role        String   @default("staff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([userId])
}

// ----------------------------------------------------
// 13. Multi-Vendor Marketplace
// ----------------------------------------------------
model Vendor {
  id              String             @id @default(cuid())
  businessName    String
  slug            String             @unique
  logo            String?
  description     String?            @default("")
  contactEmail    String
  contactPhone    String
  businessAddress String?
  category        String?            @default("General")
  gstNumber       String?
  status          String             @default("pending") // pending | approved | rejected | suspended
  rejectionReason String?
  commissionRate  Float              @default(15.0) // % platform fee
  ownerId         String             @unique
  applicationId   String?
  onboardingPath  String             @default("admin_created") // self_apply | admin_created

  // Bank & Payout Details
  bankAccountHolder String?
  bankName          String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankUpiId         String?

  // Shop Storefront & KYC Legal Documents
  shopPhotoUrl        String?
  panNumber           String?
  panDocUrl           String?
  aadharNumber        String?
  aadharDocUrl        String?
  gstDocUrl           String?
  chequeDocUrl        String?
  tradeLicenseDocUrl  String?
  kycStatus           String             @default("pending") // pending | submitted | verified | rejected
  kycNotes            String?

  // Delivery & Shipping Controls
  deliveryMethod        String             @default("self") // self | platform (vendor choice)
  deliveryFeeEnabled    Boolean            @default(true)
  customDeliveryFee     Float?             // null means follow store standard fee
  freeDeliveryThreshold Float?             // null means follow store threshold

  // Auto-Publishing Controls (Super Admin permission)
  autoPublishEnabled    Boolean            @default(false)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner           User               @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  products        Product[]
  splits          VendorOrderSplit[]
  payouts         Payout[]
  coupons         VendorCoupon[]

  @@index([status])
  @@index([ownerId])
  @@index([applicationId])
}

model VendorApplication {
  id              String   @id @default(cuid())
  businessName    String
  ownerName       String
  phone           String
  email           String
  category        String   @default("General")
  address         String?
  description     String?  @default("")
  aadharDocUrl    String?
  panDocUrl       String?
  shopPhotoUrl    String?
  status          String   @default("new_inquiry") // new_inquiry | contacted | converted | rejected
  internalNotes   String?
  rejectionReason String?
  vendorId        String?  // linked Vendor ID once converted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([email])
}

model VendorOrderSplit {
  id                 String    @id @default(cuid())
  orderId            String
  vendorId           String
  subtotal           Float
  commissionRate     Float     @default(15.0)
  commissionAmount   Float     @default(0)
  vendorPayoutAmount Float     @default(0)
  deliveryMethod     String    @default("self") // self | platform (captured at order creation)
  fulfillmentStatus  String    @default("processing") // processing | ready_for_pickup | picked_up | dispatched | out_for_delivery | delivered | cancelled | returned
  paymentCollected   Boolean   @default(false)  // true once cash/online payment is collected
  trackingNumber     String?
  courierName        String?
  deliveredAt        DateTime?
  payoutId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payout             Payout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([vendorId])
  @@index([fulfillmentStatus])
  @@index([deliveryMethod])
  @@index([payoutId])
}

model Payout {
  id             String             @id @default(cuid())
  vendorId       String
  amount         Float
  status         String             @default("pending") // pending | processing | completed | held
  periodStart    DateTime
  periodEnd      DateTime
  initiatedAt    DateTime           @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  vendor         Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  splits         VendorOrderSplit[]

  @@index([vendorId])
  @@index([status])
}

model VendorCoupon {
  id           String    @id @default(cuid())
  vendorId     String
  code         String
  discountType String    @default("percentage") // percentage | flat
  value        Float
  minOrderValue Float    @default(0)
  validFrom    DateTime  @default(now())
  validTill    DateTime
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, code])
  @@index([vendorId])
}

// ----------------------------------------------------
// Persistent Database Media & Image Storage
// ----------------------------------------------------
model UploadedFile {
  id          String   @id @default(cuid())
  fileName    String   @unique
  mimeType    String   @default("image/jpeg")
  dataBase64  String   @db.Text
  sizeBytes   Int      @default(0)
  altText     String?
  createdAt   DateTime @default(now())

  @@index([fileName])
}


